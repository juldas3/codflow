---
import type { StoreWhatsAppWidget, StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/content";
import { resolvePrefillText, buildWhatsAppHref } from "@/theme/utils/whatsapp-prefill";

interface Props {
  widget: StoreWhatsAppWidget;
  content: StoreFrontContent;
  config: StoreConfig;
}

const { widget, content, config } = Astro.props;

const agentName = widget.agentName || config.name;
const caption = widget.caption || content.waCaptionDefault;
const welcomeMessage = widget.welcomeMessage || content.waWelcomeDefault;
const ctaLabel = widget.ctaLabel || content.waCtaDefault;
const prefillGeneral = widget.prefillGeneral || content.waPrefillGeneralDefault;
const prefillProduct = widget.prefillProduct || content.waPrefillProductDefault;

// Server-side fallback link for no-JS shoppers
const initialPrefill = resolvePrefillText({
  template: prefillGeneral,
  storeName: config.name,
});
const initialHref = buildWhatsAppHref(widget.href, initialPrefill);

const isPrimary = widget.accent === "primary";
const headerBg = isPrimary ? "var(--clr-primary)" : "var(--clr-whatsapp-deep)";
const launcherBg = isPrimary ? "var(--clr-primary)" : "var(--clr-whatsapp)";
const ctaBg = isPrimary ? "var(--clr-primary)" : "var(--clr-whatsapp-deep)";
---

<div
  id="wa-widget"
  class="wa-widget"
  data-position={widget.position}
  data-accent={widget.accent}
  data-store-name={config.name}
  data-prefill-general={prefillGeneral}
  data-prefill-product={prefillProduct}
  data-attention={widget.attention ? "true" : "false"}
>
  <!-- Floating Launcher Button -->
  <button
    type="button"
    id="wa-launcher"
    class="wa-launcher flex items-center justify-center gap-2.5 h-14 rounded-full text-white cursor-pointer select-none"
    class:list={[widget.launcherLabel ? "px-5" : "w-14"]}
    style={`background: ${launcherBg}; box-shadow: var(--shadow-lg);`}
    aria-expanded="false"
    aria-controls="wa-panel"
    aria-label={content.waOpenChat}
  >
    <span class="inline-flex items-center justify-center shrink-0" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </span>
    {widget.launcherLabel && (
      <span class="text-sm font-bold tracking-tight whitespace-nowrap">{widget.launcherLabel}</span>
    )}
  </button>

  <!-- Chat Panel -->
  <div
    id="wa-panel"
    class="wa-panel overflow-hidden"
    style="border-radius: var(--radius-card); background: var(--clr-surface); border: 1px solid var(--clr-border); box-shadow: var(--shadow-lg);"
    role="dialog"
    aria-modal="false"
    aria-labelledby="wa-panel-title"
    hidden
  >
    <!-- Header -->
    <div
      class="flex items-center gap-3 px-4 py-3.5 text-white"
      style={`background: ${headerBg};`}
    >
      <div class="wa-header-avatar relative shrink-0 w-11 h-11 rounded-full overflow-hidden flex items-center justify-center" style="background: rgba(255, 255, 255, 0.15);">
        {widget.avatarUrl ? (
          <img src={widget.avatarUrl} alt="" class="w-full h-full object-cover" width="44" height="44" loading="lazy" />
        ) : config.logoUrl ? (
          <img src={config.logoUrl} alt="" class="w-full h-full object-cover" width="44" height="44" loading="lazy" />
        ) : (
          <span class="wa-avatar-fallback inline-flex items-center justify-center text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" />
            </svg>
          </span>
        )}
      </div>

      <div class="min-w-0 flex-1">
        <h3 id="wa-panel-title" class="text-sm font-bold leading-tight truncate text-white">
          {agentName}
        </h3>
        <p class="wa-caption text-xs leading-tight mt-0.5 truncate text-white/80">
          {caption}
        </p>
      </div>

      <button
        type="button"
        id="wa-close"
        class="shrink-0 p-1.5 rounded-full text-white/80 hover:text-white transition-colors cursor-pointer"
        aria-label={content.waCloseChat}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Body / Message preview -->
    <div class="p-4" style="background: var(--clr-surface);">
      <div
        class="inline-block max-w-[90%] p-3.5 text-sm leading-relaxed"
        style="border-radius: var(--radius-input); background: var(--clr-surface-alt); color: var(--clr-text);"
      >
        <p class="wa-bubble-text whitespace-pre-line m-0">{welcomeMessage}</p>
      </div>
    </div>

    <!-- Footer / Action CTA -->
    <div class="px-4 pb-4 pt-1" style="background: var(--clr-surface);">
      <a
        id="wa-cta"
        href={initialHref}
        data-base-href={widget.href}
        class="wa-cta-btn flex items-center justify-center gap-2 w-full py-3 px-4 rounded-full text-white font-bold text-sm tracking-tight transition-transform active:scale-[0.98]"
        style={`background: ${ctaBg}; box-shadow: var(--shadow-sm);`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="wa-cta-label">{ctaLabel}</span>
      </a>
    </div>
  </div>
</div>

<style>
  .wa-launcher {
    transition: transform 0.2s ease;
  }
  .wa-launcher:hover {
    transform: scale(1.05);
  }
  .wa-launcher:active {
    transform: scale(0.95);
  }

  .wa-launcher.has-pulse {
    animation: wa-attention 1.5s ease-in-out infinite;
  }

  @keyframes wa-attention {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-launcher,
    .wa-panel {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
